{
  "appId": "org.slarchive.app",
  "appName": "Surrey League",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#ffffff",
    "includePlugins": [
      "@capacitor/push-notifications"
    ],
    "zoomEnabled": true
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  },
  "android": {
    "backgroundColor": "#ffffff",
    "includePlugins": [
      "@capacitor/app",
      "@capacitor/push-notifications"
    ]
  }
}
